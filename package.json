{
  "name": "serenity-js-cucumber-playwright-template",
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf target",
    "test": "ts-node runners/executeallbrowsers.ts",
    "test:chromium": "cross-env BROWSER=chromium SERENITY_OUTPUT_DIRECTORY=target/site/serenity/chromium cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit SERENITY_OUTPUT_DIRECTORY=target/site/serenity/webkit cucumber-js",
    "test:report": "serenity-bdd run --features ./features",
    "start": "npx serve target/site/serenity/report -p 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "serenity-js",
    "bdd",
    "cucumber",
    "testing",
    "playwright",
    "playwright-test"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@eslint/js": "^9.39.4",
    "@serenity-js/assertions": "^3.40.0",
    "@serenity-js/console-reporter": "^3.40.0",
    "@serenity-js/core": "^3.40.0",
    "@serenity-js/cucumber": "^3.40.0",
    "@serenity-js/playwright": "^3.40.0",
    "@serenity-js/rest": "^3.40.0",
    "@serenity-js/serenity-bdd": "^3.40.0",
    "@serenity-js/web": "^3.40.0",
    "@types/form-data": "^2.2.1",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "is-ci": "^4.1.0",
    "jiti": "^2.6.1",
    "mkdirp": "^3.0.1",
    "npm-failsafe": "^1.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "xlsx": "^0.18.5"
  }
}
